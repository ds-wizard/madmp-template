{#- This file contains the mapping of the replies (by knowledge model annotations, see
    src/_model.j2) to the maDMP -#}
{% import "src/macros.j2" as macros with context %}
{%- import "src/_model.j2" as model with context -%}
{%- import "src/_languages.j2" as languages -%}
{%- set dc = model.dc -%}
{%- set x = model.x -%}
{#- Schema: dcsVersion ("1.0" to "1.3") and dcsProfile ("dcs" or "ostrails", based on 1.2) are set
    by the entry file of the format; what a version does not define is left out -#}
{%- set dcsMinor = dcsVersion.split(".")[1]|int -%}
{%- set isOstrails = dcsProfile == "ostrails" -%}
{#- Basic DMP metadata -#}
{#- language of the texts: the locale the document is rendered with, else the template's (en) -#}
{%- set localeCode = (dc.document.locale.code if dc.document and dc.document.locale else "en")|lower|replace("_", "-") -%}
{%- set localeLanguage = localeCode.split("-")[0] -%}
{%- set dmpLanguage = languages.iso639_3.get(localeLanguage) or (localeLanguage if localeLanguage in languages.iso639_3.values() else "eng") -%}
{#- maDMP variables -#}
{#- TRANSLATORS: description of the DMP; service = e.g. "Data Stewardship Wizard", domain = e.g. "ds-wizard.org", instance = e.g. "DSW" -#}
{%- set madmpDescription = _('This maDMP has been created using %(service)s (%(domain)s) and is based on knowledge model %(km)s (%(km_id)s). The questionnaire used for this DMP is identified by UUID "%(uuid)s" within %(url)s %(instance)s instance.',
  service=dc.config.service_name|safe,
  domain=dc.config.service_domain_name|safe,
  km=dc.km_package.name|safe,
  km_id=[dc.km_package.id, dc.km_package.version]|join(":")|safe,
  uuid=ctx.project.uuid|safe,
  url=ctx.config.clientUrl|safe,
  instance=dc.config.service_name_short|safe) -%}
{%- set madmpDmpId = {
  "identifier": ctx.config.clientUrl ~ "/projects/" ~ ctx.project.uuid,
  "type": "url"
}
-%}
{#- Text of a reply without its Markdown (e.g. of a text question) -#}
{%- macro plainText(obj) -%}
  {%- set reply = dc.questionnaire.replies.get(obj._path) -%}
  {%- if reply -%}{{ reply.markdown_plain|safe }}{%- endif -%}
{%- endmacro -%}
{#- Contributors (list) and contact -#}
{%- set contributorsMap = {
  "contactPerson": "contact person",
  "dataCollector": "data collector",
  "dataCurator": "data curator",
  "dataManager": "data manager",
  "dataProtectionOfficer": "data protection officer",
  "dataSteward": "data steward",
  "distributor": "distributor",
  "editor": "editor",
  "producer": "producer",
  "projectLeader": "project leader",
  "projectManager": "project manager",
  "projectMember": "project member",
  "researcher": "researcher",
  "rightsHolder": "rights holder",
  "sponsor": "sponsor",
  "supervisor": "supervisor",
  "workPackageLeader": "work package leader",
  "creatorOfDmp": "creator of DMP",
  "other": "other",
} -%}
{%- set contributors = [] -%}
{%- set contacts = [] -%}
{%- for item in x.administrativeInformation.contributors -%}
  {%- set contributorName = item.name._value or "" -%}
  {%- set contributorEmail = item.email._value or "" -%}
  {%- set contributorRoleCodes = item.roles|map(attribute="_value")|list -%}
  {%- set contributorRoles = [] -%}
  {%- for role in contributorRoleCodes -%}
    {%- do contributorRoles.append(contributorsMap.get(role, "other")) -%}
  {%- endfor -%}
  {%- set contributorOrcid = macros.integrationOrcid(item.orcid)|trim -%}
  {%- if contributorOrcid == "" -%}
    {%- set contributor = {
      "contributor_id": {
        "identifier": item._value,
        "type": "other"
      }
    } -%}
  {%- else -%}
    {%- set contributor = {
      "contributor_id": {
        "identifier": contributorOrcid,
        "type": "orcid"
      }
    } -%}
  {%- endif -%}
  {%- do contributor.update({"name": contributorName}) -%}
  {%- do contributor.update({"role": contributorRoles|sort}) -%}
  {%- if contributorEmail != "" -%}
    {%- do contributor.update({"mbox": contributorEmail}) -%}
  {%- endif -%}
  {%- set affiliationId = macros.rorId(item.affiliation)|trim -%}
  {%- set affiliationName = macros.integrationName(item.affiliation)|trim -%}
  {%- if dcsMinor >= 2 and affiliationId != "" and affiliationName != "" -%}{# affiliation since 1.2, its identifier is required #}
    {%- do contributor.update({"affiliation": [{
      "name": affiliationName,
      "affiliation_id": {
        "identifier": affiliationId,
        "type": "ror"
      }
    }]}) -%}
  {%- endif -%}
  {%- if contributorName != "" and contributorRoles|length > 0 -%}{# do not use invalid/incomplete #}
    {%- do contributors.append(contributor) -%}

    {%- if "contactPerson" in contributorRoleCodes and contributorEmail != "" -%}
      {%- do contacts.append(contributor) -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{#- DCS requires a contact: without a contact person, the first contributor with an e-mail -#}
{%- if contacts|length == 0 -%}
  {%- for contributor in contributors if "mbox" in contributor -%}
    {%- if loop.first -%}
      {%- do contacts.append(contributor) -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{#- Projects -#}
{%- set projects = [] -%}
{%- for item in x.administrativeInformation.projects -%}
  {%- set projectName = item.name._value or "" -%}
  {%- set projectAbstract = plainText(item.abstract) -%}
  {%- set projectStart = item.startDate._value or "" -%}
  {%- set projectEnd = item.endDate._value or "" -%}

  {%- set funding = [] -%}
  {%- for fundingItem in item.fundings -%}
    {%- set funderUrl = macros.integrationCrossref(fundingItem.funder)|trim -%}
    {%- if "10.13039/" in funderUrl -%}{# Crossref Funder Registry (FundRef) DOI #}
      {%- set funderIdType = "fundref" -%}
    {%- elif funderUrl.startswith("http") -%}
      {%- set funderIdType = "url" -%}
    {%- else -%}
      {%- set funderIdType = "other" -%}
    {%- endif -%}
    {%- set grantNumber = fundingItem.grantNumber._value or "" -%}
    {%- set fundingStatus = fundingItem.status._value if fundingItem.status._value in ["planned", "applied", "granted", "rejected"] else "" -%}

    {%- set oneFunding = {
      "funder_id": {
        "identifier": funderUrl,
        "type": funderIdType
      }
    } -%}
    {%- if fundingStatus != "" -%}
      {%- do oneFunding.update({"funding_status": fundingStatus}) -%}
    {%- endif -%}
    {%- if grantNumber != "" -%}
      {%- do oneFunding.update({
        "grant_id": {
          "identifier": grantNumber,
          "type": "url" if grantNumber.startswith("http") else "other"
        }
      }) -%}
    {%- endif -%}

    {%- if funderUrl != "" and (grantNumber != "" or dcsMinor >= 1) -%}{# do not use invalid/incomplete; 1.0 requires grant_id #}
      {%- do funding.append(oneFunding) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set projectNumber = (item.id._value or "")|trim -%}
  {%- set projectAcronym = (item.acronym._value or "")|trim -%}

  {%- set project = {
    "title": projectName
  } -%}
  {%- if projectStart -%}
    {%- do project.update({"start": projectStart}) -%}
  {%- endif -%}
  {%- if projectEnd -%}
    {%- do project.update({"end": projectEnd}) -%}
  {%- endif -%}
  {%- if item.abstract._value is not none -%}
    {%- do project.update({"description": projectAbstract}) -%}
  {%- endif -%}
  {%- if funding|length > 0 -%}
    {%- do project.update({"funding": funding}) -%}
  {%- endif -%}
  {%- if dcsMinor >= 2 and projectNumber -%}{# project_id since 1.2 #}
    {%- do project.update({"project_id": [{
      "identifier": projectNumber,
      "type": "url" if projectNumber.startswith("http") else "other"
    }]}) -%}
  {%- endif -%}
  {%- if isOstrails and projectAcronym -%}
    {%- do project.update({"acronym": projectAcronym}) -%}
  {%- endif -%}

  {%- if projectName and (dcsMinor >= 1 or (projectStart and projectEnd)) -%}{# do not use invalid/incomplete; 1.0 requires start and end #}
    {%- do projects.append(project) -%}
  {%- endif -%}
{%- endfor -%}
{#- Ethical Issues -#}
{%- set ethicalIssues = [] -%}
{%- set ethicalIssuesDescriptions = [] -%}
{%- set preexisting = x.reusingData.hasPreExistingData -%}
{%- if preexisting._value == true -%}
  {%- for item in preexisting.nonReferenceDatasets -%}
    {%- set nrefDataNameReply = item.dataset._value or "" -%}
    {%- set nrefDataWhere = item.pid._value or "" -%}
    {%- set nrefDataPersonal = item.using.includesPersonalData -%}
    {%- set nrefDataEthicalApp = item.using.needsEthicalApproval._value -%}

    {#- TRANSLATORS: name of a re-used data set that has no name -#}
    {%- set name = _('(unknown name)') -%}
    {%- if nrefDataNameReply -%}
      {%- set name = nrefDataNameReply -%}
    {%- endif -%}
    {%- if nrefDataWhere -%}
      {%- set name = name|safe ~ " (" ~ nrefDataWhere|safe ~ ")" -%}
    {%- endif -%}
    {%- if nrefDataPersonal._value == false -%}
      {%- do ethicalIssuesDescriptions.append(_('Non-reference dataset %(name)s does not contain any personal data.', name=name|safe)) -%}
    {%- elif nrefDataPersonal._value == true -%}
      {%- set nrefDataPersonalLegalBasis = nrefDataPersonal.legalBasis -%}
      {%- do ethicalIssues.append("nref-personal-data") -%}
      {%- if nrefDataPersonalLegalBasis._value == "publicInterest" -%}
        {%- do ethicalIssuesDescriptions.append(_('Non-reference dataset %(name)s contains personal data based on public interest.', name=name|safe)) -%}
      {%- elif nrefDataPersonalLegalBasis._value == "consent" -%}
        {%- if nrefDataPersonalLegalBasis.isCovered._value == true -%}
          {%- do ethicalIssuesDescriptions.append(_('Non-reference dataset %(name)s contains personal data based on consent which covers our reuse.', name=name|safe)) -%}
        {%- elif nrefDataPersonalLegalBasis.isCovered._value == false -%}
          {%- do ethicalIssuesDescriptions.append(_('Non-reference dataset %(name)s contains personal data based on consent, but the consent does not cover our intended reuse; new consent is required.', name=name|safe)) -%}
        {%- endif -%}
      {%- elif nrefDataPersonalLegalBasis._value == "other" -%}
        {%- set nrefDataPersonalLegalBasisOther = nrefDataPersonalLegalBasis.other._value -%}
        {%- if nrefDataPersonalLegalBasisOther == "legalRequirement" -%}
          {%- do ethicalIssuesDescriptions.append(_('Non-reference dataset %(name)s contains personal data based on legal requirements.', name=name|safe)) -%}
        {%- elif nrefDataPersonalLegalBasisOther == "vitalInterest" -%}
          {%- do ethicalIssuesDescriptions.append(_('Non-reference dataset %(name)s contains personal data based on vital interests.', name=name|safe)) -%}
        {%- elif nrefDataPersonalLegalBasisOther == "legitimateInterest" -%}
          {%- do ethicalIssuesDescriptions.append(_('Non-reference dataset %(name)s contains personal data based on legitimate interests.', name=name|safe)) -%}
        {%- elif nrefDataPersonalLegalBasisOther == "contract" -%}
          {%- do ethicalIssuesDescriptions.append(_('Non-reference dataset %(name)s contains personal data based on contract obligations.', name=name|safe)) -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
    {%- if nrefDataEthicalApp == "covered" -%}
      {%- do ethicalIssuesDescriptions.append(_('Non-reference dataset %(name)s has been ethically approved and no new approval is needed, as the existing ethical approval under research ethics laws covers our intended reuse of the data.', name=name|safe)) -%}
      {%- do ethicalIssues.append("nref-ethical-approval") -%}
    {%- elif nrefDataEthicalApp == "extension" -%}
      {%- do ethicalIssuesDescriptions.append(_('Non-reference dataset %(name)s has been ethically approved and an extension of the existing ethical approval under research ethics laws will be needed for the intended reuse of the data.', name=name|safe)) -%}
      {%- do ethicalIssues.append("nref-ethical-approval") -%}
    {%- elif nrefDataEthicalApp == "new" -%}
      {%- do ethicalIssuesDescriptions.append(_('Non-reference dataset %(name)s has been ethically approved but new ethical approval under research ethics laws will be required to cover our intended use of the data.', name=name|safe)) -%}
      {%- do ethicalIssues.append("nref-ethical-approval") -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- set collectPersonal = x.creatingData.collectsPersonalData -%}
{%- if collectPersonal._value == true %}
  {%- do ethicalIssuesDescriptions.append(_('We will collect data connected to a person, i.e. "personal data".')) -%}
  {%- do ethicalIssues.append("collect-personal-data") -%}
  {%- set gdpr = collectPersonal.gdpr -%}
  {%- set legalBase = gdpr.legalBasis._value -%}
  {%- if legalBase == "other" -%}
    {%- set legalBase = gdpr.legalBasis.other._value -%}
  {%- endif -%}
  {%- if legalBase == "consent" %}
    {%- do ethicalIssuesDescriptions.append(_('We ask the data subjects for their consent.')) -%}
    {%- set consent = gdpr.legalBasis.whatKind._value -%}
    {%- if consent == "specificUse" %}
      {%- do ethicalIssuesDescriptions.append(_('We will collect consent for our specific use of the data.')) -%}
    {%- elif consent == "useAndReuse" %}
      {%- do ethicalIssuesDescriptions.append(_('We will collect consent for our use as well as reuse of the data.')) -%}
    {%- elif consent == "useAndAnonymisation" %}
      {%- do ethicalIssuesDescriptions.append(_('We will collect consent for our use of the data and for anonymization; we will anonymize the data afterwards for reuse.')) -%}
    {%- elif consent == "anonymization" %}
      {%- do ethicalIssuesDescriptions.append(_('We ask for consent for anonymization; we will anonymise first and all further processing is on the anonymous data.')) -%}
    {%- endif -%}
    {%- set reusers = gdpr.legalBasis.reusersAvailable._value -%}
    {%- if reusers == false %}
      {%- do ethicalIssuesDescriptions.append(_('The consent form will not be available for re-users.')) -%}
    {%- elif reusers == true %}
      {%- do ethicalIssuesDescriptions.append(_('The consent form will be available for re-users.')) -%}
    {%- endif -%}
  {%- elif legalBase == "contract" %}
    {%- do ethicalIssuesDescriptions.append(_('We require the processing to fulfil our contract with the data subjects.')) -%}
  {%- elif legalBase == "legitimateInterest" %}
    {%- do ethicalIssuesDescriptions.append(_('We have a legitimate interest: data subjects all expect us to do this data processing because of who we are.')) -%}
  {%- elif legalBase == "vitalInterest" %}
    {%- do ethicalIssuesDescriptions.append(_('We need to do this to save the data subject (i.e. vital interest).')) -%}
  {%- elif legalBase == "legalRequirement" %}
    {%- do ethicalIssuesDescriptions.append(_('We are legally obliged to do this data processing (i.e. legal requirement).')) -%}
  {%- elif legalBase == "publicInterest" %}
    {%- do ethicalIssuesDescriptions.append(_('We do this for the benefit of society, and this is more important than the privacy of the subjects (i.e. public interest).')) -%}
  {%- endif -%}
  {%- if gdpr.needDpia._value == true %}
    {%- do ethicalIssuesDescriptions.append(_('We need to conduct a data protection impact assessment (DPIA).')) -%}
  {%- endif -%}
{%- endif -%}

{%- set ethicalLegislation = x.creatingData.collectionEthics -%}
{%- if ethicalLegislation._value == true -%}
  {%- do ethicalIssues.append("ethical-legislation") -%}
  {%- do ethicalIssuesDescriptions.append(_('The data collection is subject to ethical legislation.')) -%}
  {%- if ethicalLegislation.coveredByEthicalReview._value == true -%}
    {%- do ethicalIssuesDescriptions.append(_('The data collection is covered by an ethical review.')) -%}
  {%- elif ethicalLegislation.coveredByEthicalReview._value == false -%}
    {%- do ethicalIssuesDescriptions.append(_('The data collection is not covered by an ethical review.')) -%}
  {%- endif -%}
{%- endif -%}

{%- set canOpen = x.givingAccessToData.allOpenOverTime -%}
{%- if canOpen._value == false -%}
  {%- set legalReasons = canOpen.legalReasons -%}
  {%- if legalReasons._value == true -%}
    {%- do ethicalIssues.append("legal-reasons") -%}
    {%- do ethicalIssuesDescriptions.append(_('There are legal reasons why some of our data cannot be open.')) -%}
  {%- endif -%}
  {%- set privacyReasons = legalReasons.privacyReasons -%}
  {%- if legalReasons._value == true and privacyReasons._value == true -%}
    {%- do ethicalIssues.append("privacy-reasons") -%}
    {%- do ethicalIssuesDescriptions.append(_('There are privacy reasons so our data cannot be open.')) -%}

    {%- set privacyRestrictions = privacyReasons.storageRestrictions._value -%}
    {%- set privacyPseudo = privacyReasons.pseudonymization._value -%}
    {%- set privacyAnon = privacyReasons.anonymisation._value -%}
    {%- set privacyAggregation = privacyReasons.aggregation._value -%}

    {%- if privacyRestrictions == "none" -%}
      {%- do ethicalIssuesDescriptions.append(_('There are no restrictions where the data can be stored.')) -%}
    {%- elif privacyRestrictions == "eu" -%}
      {%- do ethicalIssuesDescriptions.append(_('Our data must stay in EU.')) -%}
    {%- elif privacyRestrictions == "country" -%}
      {%- do ethicalIssuesDescriptions.append(_('Our data must stay in the same country.')) -%}
    {%- elif privacyRestrictions == "institute" -%}
      {%- do ethicalIssuesDescriptions.append(_('Our data must stay in the same institute.')) -%}
    {%- endif -%}

    {%- if privacyPseudo == false -%}
      {%- do ethicalIssuesDescriptions.append(_('We cannot make the data more openly available by pseudonymization.')) -%}
    {%- elif privacyPseudo == true -%}
      {%- do ethicalIssuesDescriptions.append(_('We can make the data more openly available by pseudonymization.')) -%}
    {%- endif -%}

    {%- if privacyAnon == false -%}
      {%- do ethicalIssuesDescriptions.append(_('We cannot make the data more openly available by anonymization.')) -%}
    {%- elif privacyAnon == true -%}
      {%- do ethicalIssuesDescriptions.append(_('We can make the data more openly available by anonymization.')) -%}
    {%- endif -%}

    {%- if privacyAggregation == false -%}
      {%- do ethicalIssuesDescriptions.append(_('We cannot make the data more openly available through data aggregation.')) -%}
    {%- elif privacyAggregation == true -%}
      {%- do ethicalIssuesDescriptions.append(_('We can make the data more openly available through data aggregation.')) -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- if ethicalIssues|length > 0 -%}
  {%- set ethicalIssuesExist = "yes" -%}
{%- elif collectPersonal._uuid is none and ethicalLegislation._uuid is none -%}{# not answered yet #}
  {%- set ethicalIssuesExist = "unknown" -%}
{%- else -%}
  {%- set ethicalIssuesExist = "no" -%}
{%- endif -%}

{#- Datasets -#}
{%- set datasets = [] -%}
{%- for item in x.preservingData.producedDatasets -%}
  {%- set datasetName = item.dataset._value or "" -%}

  {%- if datasetName == "" -%}
    {#- TRANSLATORS: title of a produced data set that has no name -#}
    {%- set datasetName = _('(unnamed dataset)') -%}
  {%- endif -%}
  {%- set personalData = "unknown" -%}
  {%- if item.containsPersonalData._value == false -%}
    {%- set personalData = "no" -%}
  {%- elif item.containsPersonalData._value == true -%}
    {%- set personalData = "yes" -%}
  {%- endif -%}
  {%- set sensitiveData = "unknown" -%}
  {%- if item.containsSensitiveInformation._value == false -%}
    {%- set sensitiveData = "no" -%}
  {%- elif item.containsSensitiveInformation._value == true -%}
    {%- set sensitiveData = "yes" -%}
  {%- endif -%}

  {%- set identifiers = [] -%}
  {%- for identifierItem in item.identifiers -%}
    {%- set idIdentifier = (identifierItem.identifier._value or "")|trim -%}
    {%- set idTypeText = macros.integrationText(identifierItem.type)|trim -%}{# FAIRsharing record or typed value #}

    {%- if idIdentifier -%}
      {%- do identifiers.append({
        "identifier": idIdentifier,
        "type": macros.identifierType(idTypeText)|trim
      }) -%}
    {%- endif -%}
  {%- endfor -%}

  {%- set distributions = [] -%}
  {%- if item.published._value == true -%}
    {%- for distributionItem in item.published.distributions -%}
      {%- set distroAccess = "" -%}
      {%- if distributionItem.access._value == "open" -%}
        {%- set distroAccess = "open" -%}
      {%- elif distributionItem.access._value == "shared" -%}
        {%- set distroAccess = "restricted" if dcsMinor >= 3 else "shared" -%}{# 1.3 deprecated "shared" #}
      {%- elif distributionItem.access._value == "closed" -%}
        {%- set distroAccess = "closed" -%}
      {%- endif -%}

      {%- set licenses = [] -%}
      {%- for licenseItem in distributionItem.licenses -%}
        {%- set distroLicensesStart = licenseItem.startDate._value or "" -%}

        {%- set licenseRef = "" -%}
        {%- if licenseItem.license._value == "freeOpen" -%}
          {%- set licenseRef = "https://creativecommons.org/publicdomain/zero/1.0/" -%}
        {%- elif licenseItem.license._value == "freeOpenAttribution" -%}
          {%- set licenseRef = "https://creativecommons.org/licenses/by/4.0/" -%}
        {%- elif licenseItem.license._value == "restrictions" -%}
          {%- set licenseRef = licenseItem.license.licenseUrl._value or "" -%}
        {%- endif -%}

        {%- set license = {
          "license_ref": licenseRef|default(""),
          "start_date": distroLicensesStart|default("")
        } -%}
        {%- if licenseRef != "" and distroLicensesStart != "" -%}
          {%- do licenses.append(license) -%}
        {%- endif -%}
      {%- endfor -%}

      {%- set distribution = {
        "title": datasetName|default(""),
        "data_access": distroAccess|default("")
      } -%}
      {%- if licenses|length > 0 -%}
        {%- do distribution.update({"license": licenses}) -%}
      {%- endif -%}

      {#- host: the repository, named in FAIRsharing for domain-specific and general-purpose ones -#}
      {%- set repository = distributionItem.repository -%}
      {%- set repositoryReply = repository.repository if repository._value in ["domainSpecific", "generalPurpose"] else none -%}
      {%- set hostTitle = macros.integrationName(repositoryReply)|trim -%}
      {%- if hostTitle == "" and repository._uuid -%}
        {%- set hostTitle = repository._label -%}
      {%- endif -%}
      {%- set hostUrl = macros.integrationField(repositoryReply, "homepage")|trim -%}
      {%- set hostDoi = macros.integrationField(repositoryReply, "doi")|trim -%}
      {%- if hostTitle != "" and (hostUrl != "" or dcsMinor >= 3) -%}{# url is required until 1.3 #}
        {%- set host = {"title": hostTitle} -%}
        {%- if hostUrl != "" -%}
          {%- do host.update({"url": hostUrl}) -%}
        {%- endif -%}
        {%- if dcsMinor >= 2 and hostDoi != "" -%}{# host_id since 1.2 #}
          {%- do host.update({"host_id": [{"identifier": "https://doi.org/" ~ hostDoi, "type": "doi"}]}) -%}
        {%- endif -%}
        {%- do distribution.update({"host": host}) -%}
      {%- endif -%}
      {%- if distroAccess != "" -%}
        {%- do distributions.append(distribution) -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}


  {%- set dataset = {
    "dataset_id": {
        "identifier": item._value,
        "type": "other"
    },
    "title": datasetName|default(""),
    "personal_data": personalData|default(""),
    "sensitive_data": sensitiveData|default("")
  } -%}
  {%- if item.description._value is not none -%}
    {%- do dataset.update({"description": plainText(item.description)}) -%}
  {%- endif -%}
  {%- if item.type._uuid -%}{# the type as the KM names it, e.g. "Raw data" #}
    {%- do dataset.update({"type": item.type._label}) -%}
  {%- endif -%}
  {%- if item.retention._uuid -%}{# how long it will be kept, as the KM names it, e.g. "For a fixed period (prepaid): 2 years" #}
    {%- set keepPeriod = (item.retention.period._value or "")|trim if item.retention._value == "fixedPeriod" else "" -%}
    {%- do dataset.update({"preservation_statement": [item.retention._label, keepPeriod]|select|join(": ")}) -%}
  {%- endif -%}
  {%- if distributions|length > 0 -%}
    {%- do dataset.update({"distribution": distributions}) -%}
  {%- endif -%}
  {%- if identifiers|length > 0 -%}{# currently just one ID #}
    {%- do dataset.update({"dataset_id": identifiers[0]}) -%}
  {%- endif -%}
  {%- do datasets.append(dataset) -%}
{%- endfor -%}

{#- Reused datasets (is_reused since 1.2): reference and non-reference data sets the project will use -#}
{%- if dcsMinor >= 2 and preexisting._value == true -%}
  {%- set reused = [] -%}
  {%- for item in preexisting.referenceDatasets -%}
    {%- if item.using._value == true -%}
      {%- do reused.append({
        "item": item._value,
        "name": (item.dataset._value or "")|trim,
        "pid": (item.pid._value or "")|trim,
        "personal": "unknown"
      }) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for item in preexisting.nonReferenceDatasets -%}
    {%- if item.using._value == true -%}
      {%- set nrefDataPersonal = item.using.includesPersonalData._value -%}
      {%- do reused.append({
        "item": item._value,
        "name": (item.dataset._value or "")|trim,
        "pid": (item.pid._value or "")|trim,
        "personal": "yes" if nrefDataPersonal == true else ("no" if nrefDataPersonal == false else "unknown")
      }) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for data in reused -%}
    {%- if data.pid.startswith("http") -%}
      {%- set reusedId = {"identifier": data.pid, "type": "url"} -%}
    {%- elif data.pid.startswith("10.") -%}
      {%- set reusedId = {"identifier": data.pid, "type": "doi"} -%}
    {%- elif data.pid -%}
      {%- set reusedId = {"identifier": data.pid, "type": "other"} -%}
    {%- else -%}
      {%- set reusedId = {"identifier": data.item, "type": "other"} -%}
    {%- endif -%}
    {%- do datasets.append({
      "dataset_id": reusedId,
      "title": data.name or _('(unknown name)'),
      "is_reused": true,
      "personal_data": data.personal,
      "sensitive_data": "unknown"
    }) -%}
  {%- endfor -%}
{%- endif -%}

{#- Cost -#}
{%- set cost = [] -%}
{%- for projectItem in x.administrativeInformation.projects -%}
  {%- for costItem in projectItem.costs -%}
    {%- set costTitle = (costItem.title._value or "") if costItem.title is defined else "" -%}{# dsw.lifesciences 2.8.x has no Title question #}
    {%- set costAmount = costItem.amount._value -%}
    {%- set costDescriptionReply = costItem.description._value or "" -%}
    {%- set costAllocationReply = costItem.allocation|map(attribute="_value")|list -%}
    {%- set costAllocations = [] -%}

    {#- TRANSLATORS: purposes of a cost, enumerated in "This resource is allocated for %(purposes)s of data." -#}
    {%- if "findability" in costAllocationReply -%}
      {%- do costAllocations.append(_('ensuring findability')) -%}
    {%- endif -%}
    {%- if "accessibility" in costAllocationReply -%}
      {%- do costAllocations.append(_('ensuring accessibility')) -%}
    {%- endif -%}
    {%- if "interoperability" in costAllocationReply -%}
      {%- do costAllocations.append(_('ensuring interoperability')) -%}
    {%- endif -%}
    {%- if "reusability" in costAllocationReply -%}
      {%- do costAllocations.append(_('ensuring reusability')) -%}
    {%- endif -%}
    {%- if "management" in costAllocationReply -%}
      {%- do costAllocations.append(_('supporting management')) -%}
    {%- endif -%}

    {%- set costAllocation = "" -%}
    {%- if costAllocations|length > 0 -%}
      {#- TRANSLATORS: purposes = e.g. "ensuring findability and ensuring accessibility" -#}
      {%- set costAllocation = _('This resource is allocated for %(purposes)s of data.', purposes=macros.joinAnd(costAllocations)|safe) -%}
    {%- endif -%}

    {#- title is required; dsw:lifesciences 2.8.x has no Title question -#}
    {#- TRANSLATORS: title of a cost that has neither a title nor a description; number = its position -#}
    {%- set oneCost = {
      "title": costTitle or costDescriptionReply or _('Cost %(number)s', number=loop.index),
    } -%}
    {#- a number (number question), or the text of an amount that is not a plain number -#}
    {%- if costAmount is number -%}
      {%- set costValue = costAmount -%}
    {%- else -%}
      {%- set costValue = costAmount|replace(" ", "")|float(none) if costAmount else none -%}
    {%- endif -%}
    {%- if costValue is not none -%}
      {%- do oneCost.update({"value": costValue|int if costValue == costValue|int else costValue}) -%}
    {%- endif -%}
    {%- set currencyCode = macros.integrationCurrency(costItem.currency)|trim|upper -%}
    {%- if currencyCode|length == 3 and currencyCode.isalpha() -%}
      {%- do oneCost.update({"currency_code": currencyCode }) -%}
    {%- endif -%}
    {%- if costDescriptionReply or costAllocation -%}
      {%- do oneCost.update({"description": [costDescriptionReply|dot|safe if costDescriptionReply else "", costAllocation]|select|join(" ") }) -%}
    {%- endif -%}

    {%- do cost.append(oneCost) -%}

  {%- endfor -%}
{%- endfor -%}

{%- set ethicalIssuesDescription = ethicalIssuesDescriptions|join(" ") -%}
{#- DMP internal object -#}
{%- set dmp = {
  "title": ctx.project.name|default(""),
  "description": madmpDescription|default(""),
  "language": dmpLanguage,
  "dmp_id": madmpDmpId|default(""),
  "contributor": contributors|default([]),
  "project": projects|default([]),
  "ethical_issues_exist": ethicalIssuesExist|default(""),
  "dataset": datasets|default([]),
  "created": ctx.project.createdAt|datetime_format("%Y-%m-%dT%H:%M:%SZ"),
  "modified": ctx.project.updatedAt|datetime_format("%Y-%m-%dT%H:%M:%SZ"),
  "cost": cost
} -%}
{#- Only one Contact Person is permitted -#}
{%- if contacts|length > 0 -%}
  {%- do dmp.update({"contact": {
    "contact_id": contacts[0]["contributor_id"],
    "mbox": contacts[0]["mbox"],
    "name": contacts[0]["name"],
  }}) -%}
  {%- if "affiliation" in contacts[0] -%}
    {%- do dmp.contact.update({"affiliation": contacts[0]["affiliation"]}) -%}
  {%- endif -%}
{%- endif -%}
{#- OSTrails: version of the DMP = the latest named version of the project -#}
{%- if isOstrails and ctx.questionnaire.versions -%}
  {%- do dmp.update({"version": (ctx.questionnaire.versions|sort(attribute="createdAt")|last).name}) -%}
{%- endif -%}
{%- if ethicalIssuesDescriptions|length > 0 -%}
  {%- do dmp.update({"ethical_issues_description": ethicalIssuesDescription}) -%}
{%- endif -%}
{#- top-level maDMP object (according to the schema) -#}
{%- set madmp = { "dmp": dmp } -%}
