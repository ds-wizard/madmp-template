{#-
  Mapping between the dsw:root knowledge model and the RDA DMP Common Standard 1.2.

  Replies come from the `extract_replies` filter, which turns the questionnaire
  into a plain object driven by the `json.key` / `json.value` annotations of the
  knowledge model, so that no reply is addressed by its UUID path. See
  https://guide.ds-wizard.org/en/latest/more/development/document-templates/steps/jinja.html#replies-extraction

  The resulting object holds, for each annotated question:

    * value/integration question -> `none`, or `{_value, _path}` (+ `_raw`)
    * options question           -> `none`, or `{_uuid, _label, _value, _path}`
                                    with the follow-ups of the picked answer
                                    nested directly in the same object
    * multi-choice question      -> list of `{_uuid, _label, _value, _path}`
    * list question              -> list of `{_uuid, _path}` with the item
                                    questions nested directly in the same object

  `_value` carries the `json.value` annotation of the picked answer/choice. A few
  answer sets are not annotated (`_value` is `none`) and are matched on `_label`;
  those are marked below.
-#}
{#- `dc` is set before the import on purpose: the macros use it to reach the
    original reply objects, and `with context` only passes what is already
    defined at that point. -#}
{%- set dc = ctx|to_context_obj -%}
{%- import "src/macros.j2" as macros with context -%}
{%- set obj = dc|extract_replies -%}
{%- set admin = obj.administrativeInformation -%}
{%- set reusing = obj.reusingData -%}
{%- set creating = obj.creatingData -%}
{%- set preserving = obj.preservingData -%}
{%- set access = obj.givingAccessToData -%}

{#- Basic DMP metadata -#}
{%- set madmpDescription = "This maDMP has been created using " ~ dc.config.service_name ~ " (" ~ dc.config.service_domain_name ~ ") and is based on knowledge model " ~ dc.pkg.name ~ " (" ~ [dc.pkg.organization_id, dc.pkg.km_id, dc.pkg.version]|join(":") ~ "). The questionnaire used for this DMP is identified by UUID \"" ~ ctx.project.uuid ~ "\" within " ~ ctx.config.clientUrl ~ " " ~ dc.config.service_name_short ~ " instance." -%}
{%- set madmpDmpId = {
  "identifier": ctx.config.clientUrl ~ "/projects/" ~ ctx.project.uuid,
  "type": "url"
} -%}

{#-
  Contributors and contact.

  The role choices carry no `json.value` annotation, so they are matched on their
  label. Roles are expressed using the DataCite contributorType vocabulary as
  recommended by the maDMP schema; the three roles that DataCite does not define
  (data protection officer, data steward, creator of the DMP) keep their own
  CamelCase term rather than collapsing into "Other".
-#}
{%- set contributorRoles = {
  "Contact Person": "ContactPerson",
  "Data Collector": "DataCollector",
  "Data Curator": "DataCurator",
  "Data Manager": "DataManager",
  "Data Protection Officer": "DataProtectionOfficer",
  "Data Steward": "DataSteward",
  "Distributor": "Distributor",
  "Editor": "Editor",
  "Producer": "Producer",
  "Project Leader": "ProjectLeader",
  "Project Manager": "ProjectManager",
  "Project Member": "ProjectMember",
  "Researcher": "Researcher",
  "Rights Holder": "RightsHolder",
  "Sponsor": "Sponsor",
  "Supervisor": "Supervisor",
  "Work Package Leader": "WorkPackageLeader",
  "Creator of DMP": "CreatorOfDMP",
  "Other": "Other"
} -%}
{%- set contributors = [] -%}
{%- set contacts = [] -%}
{%- for c in admin.contributors -%}
  {%- set contributorName = macros.plain(c.name)|trim -%}
  {%- set contributorEmail = c.email._value|default("", true)|trim -%}
  {%- set contributorOrcid = macros.orcid_id(c.orcid)|trim -%}
  {%- set contributorRoleList = [] -%}
  {%- for role in c.roles -%}
    {%- do contributorRoleList.append(contributorRoles.get(role._label, "Other")) -%}
  {%- endfor -%}

  {#- Incomplete contributors are left out, as name and role are both required -#}
  {%- if contributorName and contributorRoleList|length > 0 -%}
    {%- if contributorOrcid -%}
      {%- set contributorId = {"identifier": contributorOrcid, "type": "orcid"} -%}
    {%- else -%}
      {%- set contributorId = {"identifier": c._uuid, "type": "other"} -%}
    {%- endif -%}
    {%- set contributor = {
      "contributor_id": contributorId,
      "name": contributorName,
      "role": contributorRoleList|unique|list|sort
    } -%}
    {%- if contributorEmail -%}
      {%- do contributor.update({"mbox": contributorEmail}) -%}
    {%- endif -%}
    {%- do contributors.append(contributor) -%}
    {%- if "ContactPerson" in contributorRoleList and contributorEmail -%}
      {%- do contacts.append(contributor) -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{#-
  Projects and costs.

  The funding status answers carry no `json.value` annotation and are matched on
  their label.
-#}
{%- set fundingStatuses = {
  "Planned": "planned",
  "Applied": "applied",
  "Granted": "granted",
  "Rejected": "rejected"
} -%}
{%- set costAllocations = {
  "Ensuring findability of data": "ensuring findability",
  "Ensuring accessibility of data": "ensuring accessibility",
  "Ensuring interoperability of data": "ensuring interoperability",
  "Ensuring re-usability of data": "ensuring reusability",
  "Supporting management of data": "supporting management"
} -%}
{%- set projects = [] -%}
{%- set cost = [] -%}
{%- set requiresEthicalApproval = [] -%}
{%- for p in admin.projects -%}
  {%- set projectTitle = macros.plain(p.name)|trim -%}
  {%- set projectStart = p.startDate._value|default("", true)|trim -%}
  {%- set projectEnd = p.endDate._value|default("", true)|trim -%}
  {%- set projectAbstract = macros.plain(p.abstract)|trim -%}

  {%- set funding = [] -%}
  {%- for f in p.fundings -%}
    {%- set funderUri = macros.funder_uri(f.funder)|trim -%}
    {%- set grantNumber = f.grantNumber._value|default("", true)|trim -%}
    {%- set fundingStatus = fundingStatuses.get(f.status._label)|default("", true) if f.status else "" -%}

    {#- A funder is required for the funding to be of any use -#}
    {%- if funderUri -%}
      {%- set oneFunding = {"funder_id": {"identifier": funderUri, "type": "url"}} -%}
      {%- if fundingStatus -%}
        {%- do oneFunding.update({"funding_status": fundingStatus}) -%}
      {%- endif -%}
      {%- if grantNumber -%}
        {%- do oneFunding.update({"grant_id": {"identifier": grantNumber, "type": "other"}}) -%}
      {%- endif -%}
      {%- do funding.append(oneFunding) -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if projectTitle -%}
    {%- set project = {"title": projectTitle} -%}
    {%- if projectAbstract -%}
      {%- do project.update({"description": projectAbstract}) -%}
    {%- endif -%}
    {%- if projectStart -%}
      {%- do project.update({"start": projectStart}) -%}
    {%- endif -%}
    {%- if projectEnd -%}
      {%- do project.update({"end": projectEnd}) -%}
    {%- endif -%}
    {%- if funding|length > 0 -%}
      {%- do project.update({"funding": funding}) -%}
    {%- endif -%}
    {%- do projects.append(project) -%}
  {%- endif -%}

  {%- if p.requiresEthicalApproval and p.requiresEthicalApproval._value -%}
    {%- do requiresEthicalApproval.append(projectTitle) -%}
  {%- endif -%}

  {%- for c in p.costs -%}
    {%- set costTitle = macros.plain(c.title)|trim -%}
    {%- set costAmount = c.amount._value|default("", true)|float(none) -%}
    {%- set costCurrency = macros.currency_code(c.currency)|trim -%}
    {#- `|format` keeps the description a plain string, see the note above -#}
    {%- set costDescription = "%s"|format(macros.plain(c.description))|trim -%}

    {%- set allocations = [] -%}
    {%- for a in c.allocation -%}
      {%- set allocation = costAllocations.get(a._label) -%}
      {%- if allocation -%}
        {%- do allocations.append(allocation) -%}
      {%- endif -%}
    {%- endfor -%}
    {%- set allocationSentence = "" -%}
    {%- if allocations|length > 2 -%}
      {%- set allocationSentence = "This resource is allocated for " ~ allocations[0:-1]|join(", ") ~ ", and " ~ allocations[-1] ~ " of data." -%}
    {%- elif allocations|length == 2 -%}
      {%- set allocationSentence = "This resource is allocated for " ~ allocations[0] ~ " and " ~ allocations[1] ~ " of data." -%}
    {%- elif allocations|length == 1 -%}
      {%- set allocationSentence = "This resource is allocated for " ~ allocations[0] ~ " of data." -%}
    {%- endif -%}

    {%- set costDescriptionParts = [] -%}
    {%- if costDescription -%}
      {%- do costDescriptionParts.append(costDescription|dot) -%}
    {%- endif -%}
    {%- if allocationSentence -%}
      {%- do costDescriptionParts.append(allocationSentence) -%}
    {%- endif -%}

    {#- A title is required for a cost -#}
    {%- if costTitle -%}
      {%- set oneCost = {"title": costTitle} -%}
      {%- if costAmount is not none -%}
        {%- do oneCost.update({"value": costAmount}) -%}
      {%- endif -%}
      {%- if costCurrency -%}
        {%- do oneCost.update({"currency_code": costCurrency}) -%}
      {%- endif -%}
      {%- if costDescriptionParts|length > 0 -%}
        {%- do oneCost.update({"description": costDescriptionParts|join(" ")}) -%}
      {%- endif -%}
      {%- do cost.append(oneCost) -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}

{#- Ethical issues -#}
{%- set ethicalIssues = [] -%}
{%- set ethicalIssuesDescriptions = [] -%}

{#- ... coming from the re-use of non-reference data sets -#}
{%- if reusing.hasPreExistingData and reusing.hasPreExistingData._value -%}
  {%- for d in reusing.hasPreExistingData.nonReferenceDatasets -%}
    {%- set datasetName = macros.plain(d.dataset)|trim|default("(unknown name)", true) -%}
    {%- set datasetPid = macros.plain(d.pid)|trim -%}
    {%- set name = datasetName ~ (" (" ~ datasetPid ~ ")" if datasetPid else "") -%}
    {#- `|format` turns the macro output back into a plain string; without it the
        sentences below would be HTML-escaped once joined (see macros.j2). -#}
    {%- set prefix = "Non-reference dataset %s"|format(name) -%}

    {%- if d.using and d.using._value -%}
      {%- set personal = d.using.includesPersonalData -%}
      {%- if personal and personal._value == false -%}
        {%- do ethicalIssuesDescriptions.append(prefix ~ " does not contain any personal data.") -%}
      {%- elif personal and personal._value -%}
        {%- do ethicalIssues.append("nref-personal-data") -%}
        {%- set legalBasis = personal.legalBasis -%}
        {%- if legalBasis and legalBasis._value == "publicInterest" -%}
          {%- do ethicalIssuesDescriptions.append(prefix ~ " contain personal data based on public interest.") -%}
        {%- elif legalBasis and legalBasis._value == "consent" -%}
          {%- if legalBasis.isCovered and legalBasis.isCovered._value -%}
            {%- do ethicalIssuesDescriptions.append(prefix ~ " contain personal data based on consent which covers our reuse.") -%}
          {%- elif legalBasis.isCovered and legalBasis.isCovered._value == false -%}
            {%- do ethicalIssuesDescriptions.append(prefix ~ " contains personal data based on consent, but the consent does not cover our intended reuse; new consent is required.") -%}
          {%- endif -%}
        {%- elif legalBasis and legalBasis._value == "other" -%}
          {%- set other = legalBasis.other -%}
          {%- if other and other._value == "legalRequirement" -%}
            {%- do ethicalIssuesDescriptions.append(prefix ~ " contain personal data based on legal requirements.") -%}
          {%- elif other and other._value == "vitalInterest" -%}
            {%- do ethicalIssuesDescriptions.append(prefix ~ " contain personal data based on vital interests.") -%}
          {%- elif other and other._value == "legitimateInterest" -%}
            {%- do ethicalIssuesDescriptions.append(prefix ~ " contain personal data based on legitimate interests.") -%}
          {%- elif other and other._value == "contract" -%}
            {%- do ethicalIssuesDescriptions.append(prefix ~ " contain personal data based on contract obligations.") -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}

      {%- set approval = d.using.needsEthicalApproval -%}
      {%- if approval and approval._value == "covered" -%}
        {%- do ethicalIssuesDescriptions.append(prefix ~ " has been ethically approved and no new approval is needed, as the existing ethical approval under research ethics laws covers our intended reuse of the data.") -%}
        {%- do ethicalIssues.append("nref-ethical-approval") -%}
      {%- elif approval and approval._value == "extension" -%}
        {%- do ethicalIssuesDescriptions.append(prefix ~ " has been ethically approved and an extension of the existing ethical approval under research ethics laws will be needed for the intended reuse of the data.") -%}
        {%- do ethicalIssues.append("nref-ethical-approval") -%}
      {%- elif approval and approval._value == "new" -%}
        {%- do ethicalIssuesDescriptions.append(prefix ~ " has been ethically approved but new ethical approval under research ethics laws will be required to cover our intended use of the data.") -%}
        {%- do ethicalIssues.append("nref-ethical-approval") -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{#- ... coming from personal data collected by the project -#}
{%- if creating.collectsPersonalData and creating.collectsPersonalData._value -%}
  {%- do ethicalIssuesDescriptions.append("We will collect data connected to a person, i.e. \"personal data\".") -%}
  {%- do ethicalIssues.append("collect-personal-data") -%}
  {%- set gdpr = creating.collectsPersonalData.gdpr -%}
  {%- if gdpr -%}
    {%- set legalBasis = gdpr.legalBasis -%}
    {%- if legalBasis and legalBasis._value == "publicInterest" -%}
      {%- do ethicalIssuesDescriptions.append("We do this for the benefit of society, and this is more important than the privacy of the subjects (i.e. public interest).") -%}
    {%- elif legalBasis and legalBasis._value == "consent" -%}
      {%- do ethicalIssuesDescriptions.append("We ask the data subjects for their consent.") -%}
      {%- set whatKind = legalBasis.whatKind -%}
      {%- if whatKind and whatKind._value == "specificUse" -%}
        {%- do ethicalIssuesDescriptions.append("We will collect consent for our specific use of the data.") -%}
      {%- elif whatKind and whatKind._value == "useAndReuse" -%}
        {%- do ethicalIssuesDescriptions.append("We will collect consent for our use as well as reuse of the data.") -%}
      {%- elif whatKind and whatKind._value == "useAndAnonymisation" -%}
        {%- do ethicalIssuesDescriptions.append("We will collect consent for our use of the data and for anonymization; we will anonymize the data afterwards for reuse.") -%}
      {%- elif whatKind and whatKind._value == "anonymization" -%}
        {%- do ethicalIssuesDescriptions.append("We ask for consent for anonymization; we will anonymise first and all further processing is on the anonymous data.") -%}
      {%- endif -%}
      {%- set reusers = legalBasis.reusersAvailable -%}
      {%- if reusers and reusers._value == false -%}
        {%- do ethicalIssuesDescriptions.append("The consent form will not be available for re-users.") -%}
      {%- elif reusers and reusers._value -%}
        {%- do ethicalIssuesDescriptions.append("The consent form will be available for re-users.") -%}
      {%- endif -%}
    {%- elif legalBasis and legalBasis._value == "other" -%}
      {%- set other = legalBasis.other -%}
      {%- if other and other._value == "contract" -%}
        {%- do ethicalIssuesDescriptions.append("We require the processing to fulfil our contract with the data subjects.") -%}
      {%- elif other and other._value == "legitimateInterest" -%}
        {%- do ethicalIssuesDescriptions.append("We have a legitimate interest: data subjects all expect us to do this data processing because of who we are.") -%}
      {%- elif other and other._value == "vitalInterest" -%}
        {%- do ethicalIssuesDescriptions.append("We need to do this to save the data subject (i.e. vital interest).") -%}
      {%- elif other and other._value == "legalRequirement" -%}
        {%- do ethicalIssuesDescriptions.append("We are legally obliged to do this data processing (i.e. legal requirement).") -%}
      {%- endif -%}
    {%- endif -%}
    {%- if gdpr.needDpia and gdpr.needDpia._value -%}
      {%- do ethicalIssuesDescriptions.append("We need to conduct a data protection impact assessment (DPIA).") -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{#- ... coming from the ethical approval required by the project -#}
{%- if requiresEthicalApproval|length > 0 -%}
  {%- do ethicalIssuesDescriptions.append("An ethical committee will make an ethical review on the project.") -%}
  {%- do ethicalIssues.append("ethical-approval") -%}
{%- endif -%}

{#- ... coming from the data that cannot be made open -#}
{%- if access.allOpenOverTime and access.allOpenOverTime._value == false -%}
  {%- set legalReasons = access.allOpenOverTime.legalReasons -%}
  {%- if legalReasons and legalReasons._value -%}
    {%- do ethicalIssues.append("legal-reasons") -%}
    {%- set privacyReasons = legalReasons.privacyReasons -%}
    {%- if privacyReasons and privacyReasons._value -%}
      {%- do ethicalIssuesDescriptions.append("There are privacy reasons so our data cannot be open.") -%}

      {%- set restrictions = privacyReasons.storageRestrictions -%}
      {%- if restrictions and restrictions._value == "none" -%}
        {%- do ethicalIssuesDescriptions.append("There are no restrictions where the data can be stored.") -%}
      {%- elif restrictions and restrictions._value == "eu" -%}
        {%- do ethicalIssuesDescriptions.append("Our data must stay in EU.") -%}
      {%- elif restrictions and restrictions._value == "country" -%}
        {%- do ethicalIssuesDescriptions.append("Our data must stay in the same country.") -%}
      {%- elif restrictions and restrictions._value == "institute" -%}
        {%- do ethicalIssuesDescriptions.append("Our data must stay in the same institute.") -%}
      {%- endif -%}

      {%- set pseudonymization = privacyReasons.pseudonymization -%}
      {%- if pseudonymization and pseudonymization._value == false -%}
        {%- do ethicalIssuesDescriptions.append("We cannot make the data more openly available by pseudonymization.") -%}
      {%- elif pseudonymization and pseudonymization._value -%}
        {%- do ethicalIssuesDescriptions.append("We can make the data more openly available by pseudonymization.") -%}
      {%- endif -%}

      {%- set anonymisation = privacyReasons.anonymisation -%}
      {%- if anonymisation and anonymisation._value == false -%}
        {%- do ethicalIssuesDescriptions.append("We cannot make the data more openly available by anonymization.") -%}
      {%- elif anonymisation and anonymisation._value -%}
        {%- do ethicalIssuesDescriptions.append("We can make the data more openly available by anonymization.") -%}
      {%- endif -%}

      {%- set aggregation = privacyReasons.aggregation -%}
      {%- if aggregation and aggregation._value == false -%}
        {%- do ethicalIssuesDescriptions.append("We cannot make the data more openly available through data aggregation.") -%}
      {%- elif aggregation and aggregation._value -%}
        {%- do ethicalIssuesDescriptions.append("We can make the data more openly available through data aggregation.") -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- set ethicalIssuesExist = "yes" if ethicalIssues|length > 0 else "no" -%}

{#- Datasets -#}
{%- set datasetIdTypes = ["handle", "doi", "ark", "url"] -%}
{%- set licenseRefs = {
  "freeOpen": "https://creativecommons.org/publicdomain/zero/1.0/",
  "freeOpenAttribution": "https://creativecommons.org/licenses/by/4.0/"
} -%}
{%- set datasets = [] -%}
{%- for d in preserving.producedDatasets -%}
  {%- set datasetTitle = macros.plain(d.dataset)|trim|default("(unnamed dataset)", true) -%}
  {%- set datasetDescription = macros.plain(d.description)|trim -%}

  {%- set personalData = "unknown" -%}
  {%- if d.containsPersonalData -%}
    {%- set personalData = "yes" if d.containsPersonalData._value else "no" -%}
  {%- endif -%}
  {%- set sensitiveData = "unknown" -%}
  {%- if d.containsSensitiveInformation -%}
    {%- set sensitiveData = "yes" if d.containsSensitiveInformation._value else "no" -%}
  {%- endif -%}

  {%- set identifiers = [] -%}
  {%- for i in d.identifiers -%}
    {%- set identifier = macros.plain(i.identifier)|trim -%}
    {%- set idTypeValue = macros.integration_plain(i.type)|trim|lower -%}
    {%- set idType = idTypeValue if idTypeValue in datasetIdTypes else "other" -%}
    {%- if identifier -%}
      {%- do identifiers.append({"identifier": identifier, "type": idType}) -%}
    {%- endif -%}
  {%- endfor -%}

  {%- set distributions = [] -%}
  {%- if d.published and d.published._value -%}
    {%- for dist in d.published.distributions -%}
      {%- set dataAccess = dist.access._value|default("", true) -%}

      {%- set licenses = [] -%}
      {%- for l in dist.licenses -%}
        {%- set licenseRef = "" -%}
        {%- if l.license -%}
          {%- if l.license._value == "restrictions" -%}
            {%- set licenseRef = l.license.licenseUrl._value|default("", true)|trim -%}
          {%- else -%}
            {%- set licenseRef = licenseRefs.get(l.license._value)|default("", true) -%}
          {%- endif -%}
        {%- endif -%}
        {%- set licenseStart = l.startDate._value|default("", true)|trim -%}
        {%- if licenseRef and licenseStart -%}
          {%- do licenses.append({"license_ref": licenseRef, "start_date": licenseStart}) -%}
        {%- endif -%}
      {%- endfor -%}

      {#- Access mode is required for a distribution -#}
      {%- if dataAccess -%}
        {%- set distribution = {"title": datasetTitle, "data_access": dataAccess} -%}
        {%- if licenses|length > 0 -%}
          {%- do distribution.update({"license": licenses}) -%}
        {%- endif -%}
        {%- do distributions.append(distribution) -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- set dataset = {
    "dataset_id": identifiers[0]|default({"identifier": "", "type": "other"}, true),
    "title": datasetTitle,
    "personal_data": personalData,
    "sensitive_data": sensitiveData
  } -%}
  {%- if datasetDescription -%}
    {%- do dataset.update({"description": datasetDescription}) -%}
  {%- endif -%}
  {%- if distributions|length > 0 -%}
    {%- do dataset.update({"distribution": distributions}) -%}
  {%- endif -%}
  {%- do datasets.append(dataset) -%}
{%- endfor -%}

{#- DMP object -#}
{%- set dmp = {
  "title": ctx.project.name|default("", true),
  "description": madmpDescription,
  "language": "eng",
  "dmp_id": madmpDmpId,
  "contributor": contributors,
  "project": projects,
  "ethical_issues_exist": ethicalIssuesExist,
  "dataset": datasets,
  "created": ctx.project.createdAt|datetime_format("%Y-%m-%dT%H:%M:%SZ"),
  "modified": ctx.project.updatedAt|datetime_format("%Y-%m-%dT%H:%M:%SZ"),
  "cost": cost
} -%}
{#- Only a single contact person is permitted -#}
{%- if contacts|length > 0 -%}
  {%- do dmp.update({"contact": {
    "contact_id": contacts[0]["contributor_id"],
    "mbox": contacts[0]["mbox"],
    "name": contacts[0]["name"]
  }}) -%}
{%- endif -%}
{%- if ethicalIssuesDescriptions|length > 0 -%}
  {%- do dmp.update({"ethical_issues_description": ethicalIssuesDescriptions|join(" ")}) -%}
{%- endif -%}

{#- Top-level maDMP object (according to the schema) -#}
{%- set madmp = {"dmp": dmp} -%}
