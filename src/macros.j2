{#- DCS identifier type (handle, doi, ark, url, other) of an identifier type given as text
    (answer label in KM 2.7, FAIRsharing record or typed value in KM 2.8+) -#}
{%- macro identifierType(text) -%}
  {%- set t = " " ~ text|lower|replace("(", " ")|replace(")", " ") ~ " " -%}
  {%- if " doi " in t or "digital object identifier" in t -%}
    doi
  {%- elif "handle" in t -%}
    handle
  {%- elif " ark " in t or "archival resource key" in t -%}
    ark
  {%- elif " url " in t or " uri " in t or "uniform resource" in t -%}
    url
  {%- else -%}
    other
  {%- endif -%}
{%- endmacro -%}

{#- Items joined into an enumeration: "A", "A and B", "A, B, and C" -#}
{%- macro joinAnd(items) -%}
  {%- if items|length > 2 -%}
    {#- TRANSLATORS: the end of an enumeration of three or more items, e.g. "A, B, and C" -#}
    {{ _("%(items)s, and %(last)s", items=items[:-1]|join(", ")|safe, last=items[-1]|safe) }}
  {%- elif items|length == 2 -%}
    {#- TRANSLATORS: an enumeration of two items, e.g. "A and B" -#}
    {{ _("%(first)s and %(last)s", first=items[0]|safe, last=items[1]|safe) }}
  {%- elif items|length == 1 -%}
    {{ items[0]|safe }}
  {%- endif -%}
{%- endmacro -%}
