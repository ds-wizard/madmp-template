{#- DCS identifier type (handle, doi, ark, url, other) of an identifier type given as text
    (answer label in KM 2.7, FAIRsharing record or typed value in KM 2.8+) -#}
{%- macro identifierType(text) -%}
  {%- set t = " " ~ text|lower|replace("(", " ")|replace(")", " ") ~ " " -%}
  {%- if " doi " in t or "digital object identifier" in t -%}
    doi
  {%- elif "handle" in t -%}
    handle
  {%- elif " ark " in t or "archival resource key" in t -%}
    ark
  {%- elif " url " in t or " uri " in t or "uniform resource" in t -%}
    url
  {%- else -%}
    other
  {%- endif -%}
{%- endmacro -%}

{#- Items joined into an enumeration: "A", "A and B", "A, B, and C" -#}
{%- macro joinAnd(items) -%}
  {%- if items|length > 2 -%}
    {#- TRANSLATORS: the end of an enumeration of three or more items, e.g. "A, B, and C" -#}
    {{ _("%(items)s, and %(last)s", items=items[:-1]|join(", ")|safe, last=items[-1]|safe) }}
  {%- elif items|length == 2 -%}
    {#- TRANSLATORS: an enumeration of two items, e.g. "A and B" -#}
    {{ _("%(first)s and %(last)s", first=items[0]|safe, last=items[1]|safe) }}
  {%- elif items|length == 1 -%}
    {{ items[0]|safe }}
  {%- endif -%}
{%- endmacro -%}

{#- ROR identifier (URL) of an organization from the ROR integration, empty without one -#}
{%- macro rorId(reply) -%}
  {%- if reply and reply._value is not none and "_raw" in reply -%}
    {%- if reply._raw and reply._raw.id -%}
      {{ reply._raw.id|safe }}
    {%- elif "](https://ror.org/" in reply._value -%}
      {{ ("https://ror.org/" ~ reply._value.split("](https://ror.org/")[1].split(")")[0])|safe }}
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}

{#- Name of the record behind an integration reply (ROR API v2 display name, FAIRsharing or ROR v1 name, the linked name of an older reply) or the typed value -#}
{%- macro integrationName(reply) -%}
  {%- if reply and reply._value is not none and "_raw" in reply -%}
    {%- set raw = reply._raw -%}
    {%- if raw and raw.names -%}
      {%- set display = [] -%}
      {%- for name in raw.names if "ror_display" in (name.types or []) -%}
        {%- do display.append(name.value) -%}
      {%- endfor -%}
      {{ (display[0] if display else raw.names[0].value)|safe }}
    {%- elif raw and raw.name -%}
      {{ raw.name|safe }}
    {%- elif "[**" in reply._value -%}
      {{ reply._value.split("[**")[1].split("**]")[0]|safe }}
    {%- else -%}
      {{ reply._value|safe }}
    {%- endif -%}
  {%- elif reply and reply._value is not none and "_raw" not in reply -%}
    {{ reply._value|safe }}
  {%- endif -%}
{%- endmacro -%}

{#- A field of the record behind an integration reply (e.g. FAIRsharing "homepage", "doi"), empty without one -#}
{%- macro integrationField(reply, field) -%}
  {%- if reply and reply._value is not none and "_raw" in reply and reply._raw and reply._raw[field] -%}
    {{ reply._raw[field]|safe }}
  {%- endif -%}
{%- endmacro -%}
