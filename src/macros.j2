{#- Macros return their text unescaped (|safe): the outputs are JSON and Turtle, not HTML -#}
{%- macro integrationOrcid(reply) -%}
  {%- if reply and reply.value.value.type == "IntegrationType" -%}
    {%- if reply.value.value.raw -%}
      {{ reply.value.value.raw["orcid-id"]|safe }}
    {%- else -%}
      {# Extract ORCID number from the value string #}
      {%- set value = reply.value.value.value %}
      {%- set orcid = value.split('ORCID:')[-1].strip().split()[0]|replace("**", "")|markdown|replace("<p>", "")|replace("</p>", "") if 'ORCID:' in value else None %}
      {%- if orcid and orcid|length >= 15 -%}
        {{ orcid }}
      {%- endif -%}
    {%- endif -%}
  {%- elif reply and reply.value.value.type == "PlainType" -%}
   {{ reply.value.value.value|safe }}
  {%- endif -%}
{%- endmacro -%}

{%- macro integrationText(reply) -%}
  {%- if reply and reply.value.value.type == "IntegrationType" -%}
    {%- if reply.value.value.raw and reply.value.value.raw.name -%}
      {{ [reply.value.value.raw.abbreviation, reply.value.value.raw.name]|select|join(" ")|safe }}
    {%- else -%}
      {{ reply.value.value.value.rsplit(" ![]")[0]|replace("**", "")|markdown|striptags|safe }}
    {%- endif -%}
  {%- elif reply and reply.value.value.type == "PlainType" -%}
    {{ reply.value.value.value|safe }}
  {%- endif -%}
{%- endmacro -%}

