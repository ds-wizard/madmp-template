{#- Macros return their text unescaped (|safe): the outputs are JSON, not HTML. The replies they
    take are objects of the extracted model (src/_model.j2): an integration reply has _value and
    _raw (the record of the integration), a reply typed by the user only _value -#}
{%- macro integrationOrcid(reply) -%}
  {%- if reply and reply._value is not none and "_raw" in reply -%}
    {%- if reply._raw -%}
      {{ reply._raw["orcid-id"]|safe }}
    {%- else -%}
      {# Extract ORCID number from the value string #}
      {%- set value = reply._value %}
      {%- set orcid = value.split('ORCID:')[-1].strip().split()[0]|replace("**", "")|markdown|replace("<p>", "")|replace("</p>", "") if 'ORCID:' in value else None %}
      {%- if orcid and orcid|length >= 15 -%}
        {{ orcid }}
      {%- endif -%}
    {%- endif -%}
  {%- elif reply and reply._value is not none and "_raw" not in reply -%}
   {{ reply._value|safe }}
  {%- endif -%}
{%- endmacro -%}

{%- macro integrationText(reply) -%}
  {%- if reply and reply._value is not none and "_raw" in reply -%}
    {%- if reply._raw and reply._raw.name -%}
      {{ [reply._raw.abbreviation, reply._raw.name]|select|join(" ")|safe }}
    {%- else -%}
      {{ reply._value.rsplit(" ![]")[0]|replace("**", "")|markdown|striptags|safe }}
    {%- endif -%}
  {%- elif reply and reply._value is not none and "_raw" not in reply -%}
    {{ reply._value|safe }}
  {%- endif -%}
{%- endmacro -%}

{%- macro integrationCrossref(reply) -%}
  {%- if reply and reply._value is not none and "_raw" in reply -%}
    {%- if reply._raw -%}
      {%- set replyObject = reply._raw -%}
      {{ replyObject.uri|safe }}
    {%- else -%}
      {{ reply._value.rsplit(" ![]")[0]|replace("**", "")|markdown|striptags|safe }}
    {%- endif -%}
  {%- elif reply and reply._value is not none and "_raw" not in reply -%}
    {{ reply._value|safe }}
  {%- endif -%}
{%- endmacro -%}

{%- macro integrationCurrency(reply) -%}
  {%- if reply and reply._value is not none and "_raw" in reply -%}
    {%- if reply._raw -%}
      {%- set replyObject = reply._raw -%}
      {{ replyObject.code|safe }}
    {%- else -%}
      {{ reply._value.rsplit(" ![]")[0]|replace("**", "")|markdown|striptags|safe }}
    {%- endif -%}
  {%- elif reply and reply._value is not none and "_raw" not in reply -%}
    {{ reply._value|safe }}
